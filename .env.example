# PostgreSQL the app reads and writes canvas designs from.
# Any PostgreSQL works — a local cluster, a managed instance, or Supabase
# (its connection string is under Project Settings → Database).
DATABASE_URL=postgres://postgres@localhost:5432/framestudio

# Optional: connections held per server instance. Keep it small on serverless.
DATABASE_POOL_MAX=5

# --- Supabase Auth (magic link) ---
# Where a magic link lands when it carries no redirect of its own. Must also
# appear in supabase/config.toml's redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From Project Settings → API. The anon key is public by design (it is sent to
# the browser); the service role key is NOT — keep it server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social sign-in. Both providers redirect to Supabase's callback, not the app's
# — see docs/auth-providers.md.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Apple's "client id" is the Services ID, and its secret is a JWT that expires
# within six months: mint it with scripts/apple-client-secret.mjs.
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

# --- Reporting ---
# Which midnight a day starts at in the admin analytics screen. The booths are
# the reference, not the server: an evening session belongs to the evening it
# happened in. IANA zone name; defaults to Asia/Jakarta.
ANALYTICS_TIMEZONE=Asia/Jakarta
