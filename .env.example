# PostgreSQL the app reads and writes canvas designs from.
# Any PostgreSQL works — a local cluster, a managed instance, or Supabase
# (its connection string is under Project Settings → Database).
DATABASE_URL=postgres://postgres@localhost:5432/framestudio

# Optional: connections held per server instance. Keep it small on serverless.
DATABASE_POOL_MAX=5

# --- Supabase Auth (magic link) ---
# Where a magic link lands when it carries no redirect of its own. Must also
# appear in supabase/config.toml's redirect allow-list.
# Where this app is reachable from outside: sign-in links, payment return
# URLs, and the address inside a share QR are all built from it.
# SITE_URL is read when a request is served, so one build can be deployed
# to several hosts; NEXT_PUBLIC_SITE_URL is frozen into the bundle at build
# time and is only the fallback.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From Project Settings → API. The anon key is public by design (it is sent to
# the browser); the service role key is NOT — keep it server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social sign-in. Both providers redirect to Supabase's callback, not the app's
# — see docs/auth-providers.md.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Apple's "client id" is the Services ID, and its secret is a JWT that expires
# within six months: mint it with scripts/apple-client-secret.mjs.
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

# --- Reporting ---
# Which midnight a day starts at in the admin analytics screen. The booths are
# the reference, not the server: an evening session belongs to the evening it
# happened in. IANA zone name; defaults to Asia/Jakarta.
ANALYTICS_TIMEZONE=Asia/Jakarta

# --- Akun staf awal (scripts/seed-roles.mjs) ---
# Alamat untuk tiga peran staf yang dibuat `npm run db:seed:roles`. Yang menyemai
# hanyalah SIAPA sebuah alamat, bukan cara membuktikannya — tidak ada kata sandi
# di sini — jadi ganti dengan alamat yang benar-benar kamu kuasai sebelum
# menjalankannya di deployment sungguhan.
SEED_ADMIN_EMAIL=admin@example.com
SEED_EDITOR_EMAIL=editor@example.com
SEED_OPERATOR_EMAIL=operator@example.com

# --- Pengiriman email ---
# Penyedia email untuk tautan masuk sekali pakai. Kosong berarti tidak ada yang
# dikirim: tautannya dicatat ke log server, yang sah untuk booth di laptop dan
# buruk untuk layanan sungguhan — respons endpoint menyebut `delivered: false`
# supaya keadaan itu tidak diam-diam.
MAIL_PROVIDER=

# --- Pembayaran ---
# Gateway untuk upgrade paket berbayar. Kosong berarti tidak ada yang bisa
# ditagih: /api/billing/checkout menolak dengan 503 dan menyebut alasannya,
# bukan diam-diam menaikkan paket akun yang belum membayar. Satu-satunya nilai
# yang dikenal saat ini adalah `midtrans`.
PAYMENT_PROVIDER=

# Server key dari dashboard Midtrans (Settings → Access Keys). Rahasia: ia
# dipakai untuk basic auth ke Snap DAN untuk memverifikasi tanda tangan
# notifikasi, jadi siapa pun yang memilikinya bisa memalsukan pembayaran.
MIDTRANS_SERVER_KEY=

# `true` memakai endpoint produksi Midtrans; apa pun selain itu memakai sandbox.
MIDTRANS_PRODUCTION=false
